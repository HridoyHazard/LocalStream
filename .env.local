# LocalStream configuration
# Base URL of the h5ai / HTTP directory index that holds the media library.
MEDIA_SERVER_URL="http://172.16.50.7/DHAKA-FLIX-7/"

# SQLite database (relative to the project root)
DATABASE_PATH="data/localstream.db"

# Scanner
SCAN_ON_START=true
SCAN_INTERVAL_MINUTES=45
SCAN_CONCURRENCY=8

# Optional TMDB metadata. Leave empty to use local artwork only.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_AUTO_ENRICH=true

# Optional VLC companion launcher (scripts/vlc-companion.mjs)
VLC_COMPANION_URL="http://127.0.0.1:8642"
