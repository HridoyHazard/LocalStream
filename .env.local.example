# Media server (h5ai index root)
MEDIA_SERVER_URL="http://172.16.50.7/DHAKA-FLIX-7/"

# Extra servers (Hindi, South Indian, Animation, Korean TV, TV series, Anime, WWE...).
# Defaults: 14, 12 and 10 on 172.16.50.x. Set ENABLE_EXTRA_SERVERS=false to scan only the primary server.
# EXTRA_MEDIA_SERVERS replaces the defaults, format id=url,id=url (empty value disables them).
# ENABLE_EXTRA_SERVERS=true
# EXTRA_MEDIA_SERVERS="14=http://172.16.50.14/DHAKA-FLIX-14/,12=http://172.16.50.12/DHAKA-FLIX-12/,10=http://172.16.50.10/DHAKA-FLIX-10/"
# Section folders per server are listed in src/lib/server/sources.ts.

# SQLite index
DATABASE_PATH="data/localstream.db"

# Scanner
SCAN_ON_START=true
SCAN_INTERVAL_MINUTES=45
SCAN_CONCURRENCY=8
SCAN_REQUEST_TIMEOUT_MS=20000

# Optional TMDB metadata and artwork
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_AUTO_ENRICH=true

# Optional VLC companion
VLC_COMPANION_URL="http://127.0.0.1:8642"
VLC_COMPANION_HOST=127.0.0.1
VLC_COMPANION_PORT=8642
VLC_PATH=

# Embedded subtitle extraction (ffmpeg/ffprobe are bundled with npm install)
FFMPEG_PATH=
FFPROBE_PATH=
SUBTITLE_CACHE_DIR="data/subtitles"

# App name
NEXT_PUBLIC_APP_NAME=LocalStream
